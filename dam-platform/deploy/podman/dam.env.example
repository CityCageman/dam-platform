# ============================================================================
# 生产部署环境变量（复制为 dam.env 后按实际环境修改）
#   cp deploy/podman/dam.env.example deploy/podman/dam.env
# 注意：dam.env 含口令，不要提交到代码仓库
# ============================================================================

# 镜像版本与命名前缀（与 build-images.sh 的 VERSION 保持一致）
VERSION=1.0.0
IMAGE_PREFIX=localhost

# 容器网络名（前后端同机时复用，用于 Nginx 反代容器名）
NET=dam-net

# ---------------- 数据库（外部 PG / TBase） ----------------
DB_HOST=10.162.3.16
DB_PORT=11001
DB_NAME=damplatform
DB_USER=dam
DB_PASSWORD=change-me
SA_TOKEN_JWT_SECRET_KEY=ChangeMe_JWT_Secret_At_Least_32_Chars
DAM_CORS_ORIGINS=http://localhost:5173

# ---------------- Nacos（无 Nacos 时保持 false 且留空地址） ----------------
NACOS_ENABLED=false
NACOS_SERVER_ADDR=

# ---------------- 网关 ----------------
GATEWAY_PORT=8080
# 生产无 Nacos 时，网关直接按容器名路由（脚本会自动注入）
# 若启用 Nacos，可保持默认 lb://dam-xxx

# ---------------- 智能体（LLM） ----------------
DAM_MODEL_GATEWAY_CODE_BASE_URL=
DAM_MODEL_GATEWAY_CODE_API_KEY=
DAM_MODEL_GATEWAY_CODE_MODEL=qwen3-coder-30b-a3b

# ---------------- 前端 ----------------
FRONTEND_PORT=80
# 后端网关地址：前后端同机用 dam-gateway:8080；分离部署填后端服务器 IP:端口
BACKEND_GATEWAY=dam-gateway:8080
