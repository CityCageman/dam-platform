# Docker Compose / start.sh 环境变量模板
# 复制为 deploy/.env 并按实际填写（.env 不要提交到 git）

# ---- 数据库 ----
# 本地一体化（docker-compose.backend.yml / docker-compose.yml）使用容器内 postgres，下面三项无需配置；
# 两服务器（docker-compose.app.yml）默认连接 10.162.3.16:11001，可按需覆盖：
# DB_HOST=10.162.3.16
# DB_PORT=11001
# DB_USERNAME=dam
DB_PASSWORD=change-me
# 所有后端服务与网关必须使用同一 JWT 密钥，否则网关门禁验签/跨服务调用返回 401
SA_TOKEN_JWT_SECRET_KEY=ChangeMe_JWT_Secret_At_Least_32_Chars
DAM_CORS_ORIGINS=http://localhost:5173

# ---- Nacos（docker-compose.app.yml 使用，默认 192.168.1.13:8848）----
# NACOS_HOST=192.168.1.13

# ---- 智能体（dam-model-gateway，密钥务必替换为真实值）----
DAM_MODEL_GATEWAY_CODE_BASE_URL=https://coder.cuhkszmc.cn/v1/chat/completions
DAM_MODEL_GATEWAY_CODE_API_KEY=sk-xxxxxxxxxxxxxxxx
DAM_MODEL_GATEWAY_CODE_MODEL=qwen3-coder-30b-a3b
