# systemd 部署环境变量示例
# 复制为 /etc/dam/env.conf 并按实际修改；仅本机 PostgreSQL 部署需数据库三项，网关路由默认 localhost 可省略

# ---- 数据库连接（连库服务共用）----
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/damplatform
SPRING_DATASOURCE_USERNAME=dam
SPRING_DATASOURCE_PASSWORD=ChangeMe_2026

# ---- 鉴权（所有服务必须一致；openssl rand -base64 48）----
SA_TOKEN_JWT_SECRET_KEY=ChangeMe_JWT_Secret_At_Least_32_Chars

# ---- 网关 CORS（前后端同源反代时可不配；分离部署填前端来源）----
DAM_CORS_ORIGINS=http://localhost:5173

# ---- 模型网关（dam-model-gateway；只负责模型调用，不承载业务）----
DAM_MODEL_GATEWAY_CODE_BASE_URL=https://coder.cuhkszmc.cn/v1/chat/completions
DAM_MODEL_GATEWAY_CODE_API_KEY=sk-xxxxxxxxxxxxxxxx
DAM_MODEL_GATEWAY_CODE_MODEL=qwen3-coder-30b-a3b
DAM_MODEL_GATEWAY_CODE_TIMEOUT_SECONDS=240

# ---- 网关路由地址（仅 dam-gateway；同机部署默认 localhost 无需设置，拆分部署改成内网地址）----
# DAM_ROUTE_AUTH=http://192.168.1.10:8081
# DAM_ROUTE_CATALOG=http://192.168.1.10:8092
# DAM_ROUTE_LINEAGE=http://192.168.1.10:8093
# DAM_ROUTE_STANDARD=http://192.168.1.10:8084
# DAM_ROUTE_QUALITY=http://192.168.1.10:8085
# DAM_ROUTE_SECURITY=http://192.168.1.10:8086
# DAM_ROUTE_LIFECYCLE=http://192.168.1.10:8087
# DAM_ROUTE_OPERATIONS=http://192.168.1.10:8088
# DAM_ROUTE_MODEL_GATEWAY=http://192.168.1.10:8089
# DAM_ROUTE_AI_WORKBENCH=http://192.168.1.10:8090
# DAM_MODEL_GATEWAY_URL=http://192.168.1.10:8089


# ---------------- WeKnora 知识库 ----------------
# 必须带 /api/v1，末尾不要加 /
DAM_WEKNORA_BASE_URL=https://wiki-medical.cuhkszmc.cn/api/v1
# 空间级 API Key；建议用单引号，避免特殊字符被 shell 解析
DAM_WEKNORA_API_KEY='CHANGE_ME_WEKNORA_KEY'
# 与 WeKnora 设置中的模型名称保持一致
DAM_WEKNORA_LLM_MODEL=qwen3-coder-30b-a3b
DAM_WEKNORA_EMBEDDING_MODEL=bge-m3

# ---- AI 工作台独立数据库账号（只授权 dam_ai schema）----
# DAM_AI_DB_URL=jdbc:postgresql://127.0.0.1:5432/damplatform
# DAM_AI_DB_USERNAME=dam_ai
# DAM_AI_DB_PASSWORD=ChangeMe_AI
