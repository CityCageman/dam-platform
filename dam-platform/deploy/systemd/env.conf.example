# systemd 部署环境变量示例
# 复制为 /etc/dam/env.conf 并按实际修改；仅本机 PostgreSQL 部署需数据库三项，网关路由默认 localhost 可省略

# ---- 数据库连接（连库服务共用）----
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/damplatform
SPRING_DATASOURCE_USERNAME=dam
SPRING_DATASOURCE_PASSWORD=ChangeMe_2026

# ---- 智能体（仅 dam-agent）----
DAM_AGENT_CHAT_BASE_URL=https://llm-tp8.cuhkszmc.cn/v1/chat/completions
DAM_AGENT_CHAT_API_KEY=sk-xxxxxxxxxxxxxxxx
DAM_AGENT_CHAT_MODEL=qwen3.8-27b-tp8
DAM_AGENT_CODE_BASE_URL=https://coder.cuhkszmc.cn/v1/chat/completions
DAM_AGENT_CODE_API_KEY=sk-xxxxxxxxxxxxxxxx
DAM_AGENT_CODE_MODEL=qwen3-coder-30b-a3b

# ---- 网关路由地址（仅 dam-gateway；同机部署默认 localhost 无需设置，拆分部署改成内网地址）----
# DAM_ROUTE_AUTH=http://192.168.1.10:8081
# DAM_ROUTE_CATALOG=http://192.168.1.10:8092
# DAM_ROUTE_LINEAGE=http://192.168.1.10:8093
# DAM_ROUTE_STANDARD=http://192.168.1.10:8084
# DAM_ROUTE_QUALITY=http://192.168.1.10:8085
# DAM_ROUTE_SECURITY=http://192.168.1.10:8086
# DAM_ROUTE_LIFECYCLE=http://192.168.1.10:8087
# DAM_ROUTE_OPERATIONS=http://192.168.1.10:8088
# DAM_ROUTE_AGENT=http://192.168.1.10:8089
